# URL publique du site (utilisée pour les metadata / Open Graph / sitemap)
NEXT_PUBLIC_SITE_URL=https://www.pm-formations.com

# Numéros WhatsApp de secours (utilisés uniquement si le document Sanity
# `settings` est vide ou inaccessible). Format international, chiffres
# uniquement ou avec séparateurs — voir src/lib/whatsapp.ts.
NEXT_PUBLIC_WHATSAPP_PM=2250700000000
NEXT_PUBLIC_WHATSAPP_PHERINA=2250700000000
NEXT_PUBLIC_WHATSAPP_MAURISSON=2250700000000

# Sanity (ajoutés à l'étape 2 — schémas + Studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Token en lecture seule, requis uniquement si le dataset n'est pas public
# (aperçu de contenu non publié, previews Studio, script de seed).
SANITY_API_TOKEN=
